{
  "manifest_version": 3,
  "name": "Manhwa Log",
  "version": "1.0.0",
"version_name": "1.0 — Initial Release",
"author": "Sumanth",
  "description": "Auto-tracks your manhwa reading progress across all sites",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Manhwa Log",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+M",
        "mac": "Command+M"
      },
      "description": "Open Manhwa Log"
    }
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: data:; connect-src https:; default-src 'self'"
  },

  "permissions": ["storage", "scripting", "tabs", "declarativeNetRequestWithHostAccess"],

  "host_permissions": [
    "*://*.webtoons.com/*",
    "*://*.tappytoon.com/*",
    "*://*.tapas.io/*",
    "*://*.manta.net/*",
    "*://*.asurascans.com/*",
    "*://*.asuracomic.net/*",
    "*://*.arenascan.com/*",
    "*://toongod.org/*",
    "*://*.toongod.org/*",
    "*://*.toongod.xyz/*",
    "*://*.kingofshojo.com/*",
    "*://*.kunmanga.com/*",
    "*://*.manhwaclan.com/*",
    "*://*.manhwatop.com/*",
    "*://*.manhuaus.com/*",
    "*://*.mangafire.to/*",
    "*://*.hivetoons.org/*",
    "*://*.flamecomics.xyz/*",
    "*://*.toonily.me/*",
    "*://*.toonily.com/*"
  ],

  "background": {
    "service_worker": "src/background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.webtoons.com/*",
        "*://*.tappytoon.com/*",
        "*://*.tapas.io/*",
        "*://*.manta.net/*",
        "*://*.asurascans.com/*",
        "*://*.asuracomic.net/*",
        "*://*.arenascan.com/*",
        "*://toongod.org/*",
        "*://*.toongod.org/*",
        "*://*.toongod.xyz/*",
        "*://*.kingofshojo.com/*",
        "*://*.kunmanga.com/*",
        "*://*.manhwaclan.com/*",
        "*://*.manhwatop.com/*",
        "*://*.manhuaus.com/*",
        "*://*.mangafire.to/*",
        "*://*.hivetoons.org/*",
        "*://*.flamecomics.xyz/*",
        "*://*.toonily.me/*",
        "*://*.toonily.com/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
